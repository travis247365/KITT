#!/usr/bin/env node
// KITT command line: operate the hub without the car. Runs in-process (no server needed) except `serve`.
import path from 'node:path';
import fs from 'node:fs';
import { fileURLToPath } from 'node:url';

const HERE = path.dirname(fileURLToPath(import.meta.url));
const SRC = path.join(HERE, '..', 'src');
const [cmd, ...rest] = process.argv.slice(2);

const USAGE = `kitt — Travis's in-car agent hub

  kitt serve                      start the HTTP hub (foreground)
  kitt ask "<text>"               route a spoken command and print what Kit would say
  kitt brief <morning|evening|skill>
  kitt confirm | cancel | more
  kitt sms "<sender>" "<body>"    simulate a forwarded transaction SMS
  kitt idea "<text>"              capture an idea
  kitt skills | routines | pending | health | audit [n]
  kitt routine run <name>
  kitt token new [app|full|read|feed]  print a fresh token and the env line to add (app = phone/watch, no admin)
  kitt doctor                     reachability facts: launchd, tunnel, power/sleep, battery, 7-day uptime coverage
  kitt shortcuts build [baseUrl]  generate + sign the Siri Shortcuts
  kitt podcast render <morning|evening>
  kitt linktree login             connect Linktree (opens the browser once; official Linktree MCP + OAuth)
  kitt secret set <NAME>          store a secret from a hidden prompt (or piped stdin); checks the board login for KITT_COO_PASSWORD
  kitt secret list                names that are set (never values)
  kitt whatsapp link              start the WhatsApp listener and open the pairing page (scan the QR once)
  kitt whatsapp status            what the listener is doing right now
  kitt restart                    restart the hub (launchd if installed, otherwise a detached process) and wait for it to answer
  kitt ideas chat                 print how to open the persistent KITT Ideas conversation in Claude Code
  kitt init                       create ~/.config/kitt/kitt.env (chmod 600) with fresh tokens if missing
  kitt setup                      show what is configured and what Travis still needs to do
`;

async function main() {
  if (!cmd || cmd === 'help' || cmd === '-h' || cmd === '--help') { process.stdout.write(USAGE); return; }
  if (cmd === 'serve') { const { startServer } = await import(path.join(SRC, 'server.js')); await startServer(); return; }
  if (cmd === 'token') {
    const { newToken } = await import(path.join(SRC, 'auth.js'));
    const kind = rest[1] || 'app'; const key = { full: 'KITT_TOKEN', app: 'KITT_APP_TOKEN', read: 'KITT_READ_TOKEN', feed: 'KITT_FEED_TOKEN' }[kind];
    if (!key) throw new Error('kind must be full|app|read|feed');
    const t = newToken(32);
    process.stdout.write(`${key}=${t}\n# add the line above to ~/.config/kitt/kitt.env (chmod 600) and restart the hub\n`);
    return;
  }
  if (cmd === 'init') {
    const { newToken } = await import(path.join(SRC, 'auth.js'));
    const { CONFIG_DIR } = await import(path.join(SRC, 'config.js'));
    fs.mkdirSync(CONFIG_DIR, { recursive: true, mode: 0o700 });
    const envFile = path.join(CONFIG_DIR, 'kitt.env');
    if (fs.existsSync(envFile)) { process.stdout.write(`${envFile} already exists — not touching it. Use 'kitt token new' to add tokens.\n`); return; }
    const body = [
      '# KITT secrets — chmod 600. Never commit. Generated by `kitt init`.',
      `KITT_TOKEN=${newToken(32)}`,
      `KITT_APP_TOKEN=${newToken(32)}`,
      `KITT_FEED_TOKEN=${newToken(32)}`,
      '# Optional: KITT_ANTHROPIC_API_KEY=sk-ant-...   (API fallback; default brain is `claude -p` under the Max plan)',
      '# Optional: KITT_EMAIL_TO=you@example.com',
      '# Skill secrets are documented in docs/SETUP.md (COO board password, Cloudflare token, ...)',
      '',
    ].join('\n');
    fs.writeFileSync(envFile, body, { mode: 0o600 });
    fs.chmodSync(envFile, 0o600);
    process.stdout.write(`wrote ${envFile} (mode 600) with KITT_TOKEN and KITT_FEED_TOKEN\n`);
    return;
  }
  if (cmd === 'secret') {
    const { SETTABLE, writeSecret, listSecretNames, checkBoardLogin, readHidden, readStdin } = await import(path.join(SRC, 'secrets.js'));
    const { loadConfig } = await import(path.join(SRC, 'config.js'));
    const { secrets, config, paths } = loadConfig();
    if (rest[0] === 'list') { for (const n of listSecretNames(paths.envFile)) process.stdout.write(`${n}\n`); return; }
    if (rest[0] !== 'set' || !rest[1]) throw new Error(`usage: kitt secret set <${SETTABLE.join('|')}>`);
    const name = rest[1];
    if (!SETTABLE.includes(name)) throw new Error(`${name} is not settable here. Allowed: ${SETTABLE.join(', ')}. Hub tokens use 'kitt token new'.`);
    const value = (process.stdin.isTTY ? await readHidden(`${name} (typing is hidden; paste works): `) : await readStdin()).trim();
    if (!value) throw new Error('nothing entered; nothing changed');
    if (name === 'KITT_COO_PASSWORD') {
      const base = secrets.KITT_COO_BASE_URL || config.chief?.base_url || 'https://board.example';
      const email = (secrets.KITT_COO_EMAIL || '').trim();
      const r = await checkBoardLogin(base, value, { email });
      if (!r.ok) {
        process.stdout.write(`The board did not accept that ${r.via} login (${r.status ? `HTTP ${r.status}` : r.error}). Nothing was saved.\n`);
        if (r.status === 401) process.stdout.write(email ? 'Check the account email and password, and that the account is confirmed (the link in its sign-up e-mail).\n' : 'This route takes ONLY the board\'s shared team password (the APP_PASSWORD setting), not a Google sign-in or a personal account password.\nTo use a dedicated board account instead, run it with its e-mail: KITT_COO_EMAIL=you@example.com kitt secret set KITT_COO_PASSWORD\n');
        process.exitCode = 1; return;
      }
      writeSecret(paths.envFile, name, value);
      if (process.env.KITT_COO_EMAIL) writeSecret(paths.envFile, 'KITT_COO_EMAIL', process.env.KITT_COO_EMAIL.trim());
      process.stdout.write(`Board login OK as ${r.role} (${r.via}). Saved ${name} in ${paths.envFile} (mode 600).\nNext: kitt routine run chief.sync   then restart the hub so it picks it up.\n`);
      return;
    }
    writeSecret(paths.envFile, name, value);
    process.stdout.write(`Saved ${name} in ${paths.envFile} (mode 600). Restart the hub to use it.\n`);
    return;
  }
  if (cmd === 'restart') {
    const { execFileSync, spawn } = await import('node:child_process');
    const { loadConfig } = await import(path.join(SRC, 'config.js'));
    const port = loadConfig().config.server?.port || 2000;
    const plist = path.join(process.env.HOME, 'Library/LaunchAgents/com.tpcl.kitt.plist');
    if (fs.existsSync(plist)) { execFileSync('launchctl', ['kickstart', '-k', `gui/${process.getuid()}/com.tpcl.kitt`]); process.stdout.write('restarting the hub through launchd\n'); }
    else {
      let pids = ''; try { pids = execFileSync('pgrep', ['-f', 'bin/kitt serve'], { encoding: 'utf8' }); } catch { /* none running */ }
      for (const pid of pids.split(/\s+/).filter(Boolean)) { if (Number(pid) !== process.pid) { try { process.kill(Number(pid), 'SIGTERM'); } catch { /* already gone */ } } }
      await new Promise((r) => setTimeout(r, 1500));
      const logFile = path.join(process.env.HOME, 'Library/Logs/kitt.log');
      const out = fs.openSync(logFile, 'a');
      const child = spawn(process.execPath, [path.join(HERE, 'kitt'), 'serve'], { cwd: path.join(HERE, '..'), detached: true, stdio: ['ignore', out, out] });
      child.unref();
      process.stdout.write(`started a detached hub (pid ${child.pid}); logs: ${logFile}\n`);
    }
    for (let i = 0; i < 80; i++) { // the hub loads twelve skills and can take ~20 s to start
      await new Promise((r) => setTimeout(r, 500));
      try { const r = await fetch(`http://127.0.0.1:${port}/healthz`, { signal: AbortSignal.timeout(1500) }); if (r.ok) { process.stdout.write(`hub answering on port ${port}\n`); return; } } catch { /* not up yet */ }
    }
    throw new Error(`the hub did not answer on port ${port} within 40 seconds; see ~/Library/Logs/kitt.log`);
  }
  if (cmd === 'whatsapp' && rest[0] === 'link') {
    const { spawn } = await import('node:child_process');
    const child = spawn(process.execPath, [path.join(SRC, 'skills', 'whatsapp', 'listener.mjs'), '--open'], { stdio: 'inherit' });
    child.on('exit', (code) => process.exit(code ?? 0));
    for (const sig of ['SIGINT', 'SIGTERM']) process.on(sig, () => child.kill(sig));
    return;
  }
  if (cmd === 'shortcuts') { const { buildAll } = await import(path.join(SRC, 'carplay', 'shortcuts.js')); const out = await buildAll({ baseUrl: rest[1] }); for (const o of out) process.stdout.write(`${o.status}\t${o.file}\n`); return; }

  const { createApp } = await import(path.join(SRC, 'app.js'));
  const app = await createApp();
  const say = (r) => { process.stdout.write((typeof r === 'string' ? r : r.speak || JSON.stringify(r, null, 2)) + '\n'); if (r && r.needs_confirm) process.stdout.write(`[needs confirm: kitt confirm]\n`); if (r && r.display) process.stdout.write(`\n${typeof r.display === 'string' ? r.display : JSON.stringify(r.display, null, 2)}\n`); };
  switch (cmd) {
    case 'ask': say(await app.ask(rest.join(' '), { source: 'cli' })); break;
    case 'brief': say(await app.brief(rest[0] || 'morning', { source: 'cli' })); break;
    case 'confirm': say(await app.confirm('cli')); break;
    case 'cancel': say(app.cancel('cli')); break;
    case 'more': say(app.more('cli')); break;
    case 'sms': { const s = app.skills.money; if (!s) throw new Error('money skill unavailable'); console.log(JSON.stringify(await s.ingestSms({ sender: rest[0], body: rest.slice(1).join(' ') }, { ...app, source: 'cli' }), null, 2)); break; }
    case 'idea': { const s = app.skills.ideas; if (!s) throw new Error('ideas skill unavailable'); say(await s.capture({ text: rest.join(' ') }, { ...app, source: 'cli' })); break; }
    case 'skills': for (const s of app.skillList) { console.log(`${s.id.padEnd(14)} ${s.name} — ${s.intents.length} intents, ${(s.routines || []).length} routines`); for (const i of s.intents) console.log(`   · ${i.name}${i.write ? ' [write]' : ''}: ${(i.examples || [])[0] || ''}`); } for (const f of app.failures) console.log(`${f.id.padEnd(14)} UNAVAILABLE — ${f.error}`); break;
    case 'routines': for (const r of app.scheduler.list()) console.log(`${r.name.padEnd(28)} ${r.cron.padEnd(14)} last=${r.last_run_at || 'never'} ${r.last_status || ''} ${(r.last_summary || '').slice(0, 80)}`); break;
    case 'routine': { if (rest[0] !== 'run' || !rest[1]) throw new Error('usage: kitt routine run <name>'); console.log(JSON.stringify(await app.scheduler.runNow(rest[1], { source: 'cli' }), null, 2)); break; }
    case 'pending': { const { listPending } = await import(path.join(SRC, 'confirm.js')); console.log(JSON.stringify(listPending(app.db), null, 2)); break; }
    case 'health': console.log(JSON.stringify(await app.health(), null, 2)); break;
    case 'audit': { const { tailAudit } = await import(path.join(SRC, 'audit.js')); for (const a of tailAudit(app.db, Number(rest[0] || 30)).reverse()) console.log(`${a.ts} ${a.source.padEnd(6)} ${String(a.skill || '').padEnd(12)} ${String(a.intent || '').padEnd(22)} ${a.outcome.padEnd(13)} ${a.latency_ms ?? ''}ms ${(a.input || '').slice(0, 60)}`); break; }
    case 'podcast': { const { createPodcast } = await import(path.join(SRC, 'carplay', 'podcast.js')); const pc = createPodcast(app); if (rest[0] === 'render') { const kind = rest[1] || 'morning'; const b = await app.brief(kind, { source: 'podcast' }); const full = b.speak + (app.more('podcast').speak !== "That's everything." ? ' ' + app.more('podcast').speak : ''); console.log(JSON.stringify(await pc.render({ slug: kind, title: `${kind[0].toUpperCase() + kind.slice(1)} brief ${new Date().toISOString().slice(0, 10)}`, text: full }), null, 2)); } else console.log(JSON.stringify(pc.list(), null, 2)); break; }
    case 'linktree': {
      const s = app.skills.linktree; if (!s) throw new Error('linktree skill unavailable');
      if (rest[0] === 'login') { const { authUrl, done } = await s._mcp.login({ open: true }); process.stdout.write(`Opened the browser for Linktree sign-in. If it did not open, visit:\n${authUrl}\nWaiting up to 10 minutes...\n`); await done; process.stdout.write('Linktree connected.\n'); console.log(JSON.stringify(s._mcp.status())); }
      else if (rest[0] === 'status') console.log(JSON.stringify(s._mcp.status(), null, 2));
      else if (rest[0] === 'tools') console.log(JSON.stringify((await s._mcp.listTools()).tools?.map((t) => t.name), null, 2));
      else throw new Error('usage: kitt linktree login|status|tools');
      break;
    }
    case 'ideas': { const s = app.skills.ideas; if (!s) throw new Error('ideas skill unavailable'); if (rest[0] === 'chat') process.stdout.write(s.chatInstructions() + '\n'); else say(await s.handle('recap', { period: rest[0] || 'week' }, { ...app, source: 'cli' })); break; }
    case 'doctor': {
      const { execFileSync } = await import('node:child_process');
      const sh = (cmd, args) => { try { return execFileSync(cmd, args, { encoding: 'utf8', timeout: 8000 }); } catch (e) { return (e.stdout || '') + (e.stderr || ''); } };
      const la = fs.existsSync(path.join(process.env.HOME, 'Library/LaunchAgents/com.tpcl.kitt.plist'));
      const ng = fs.existsSync(path.join(process.env.HOME, 'Library/LaunchAgents/com.tpcl.kitt-ngrok.plist'));
      const batt = sh('/usr/bin/pmset', ['-g', 'batt']).split('\n').slice(0, 2).join(' ').replace(/\s+/g, ' ');
      const custom = sh('/usr/bin/pmset', ['-g', 'custom']);
      const acSleep = (/AC Power:[\s\S]*?\n\s*sleep\s+(\d+)/.exec(custom) || [])[1]; const battSleep = (/Battery Power:[\s\S]*?\n\s*sleep\s+(\d+)/.exec(custom) || [])[1];
      let healthz = 'down'; try { const r = await fetch(`http://127.0.0.1:${app.config.server?.port || 2000}/healthz`, { signal: AbortSignal.timeout(3000) }); healthz = r.ok ? `up (${(await r.json()).uptime_s}s)` : `HTTP ${r.status}`; } catch { /* down */ }
      const cov = app.coverage(7);
      // where the hub actually listens (the open sockets, not the config) and the firewall: GRC audit R1
      const os = await import('node:os'); const { listenPlan, readNetworkSignature, tailscaleAddresses } = await import(path.join(SRC, 'net.js')); const { readFirewall, readListeners, openToNetwork } = await import(path.join(SRC, 'skills', 'security', 'exposure.js'));
      const hubPort = app.config.server?.port || 2000; const plan = listenPlan(app.config.server || {}, { ifaces: os.networkInterfaces(), signature: readNetworkSignature(), requireRouter: process.platform === 'darwin' });
      const listeners = await readListeners(); const firewall = await readFirewall(); const ts = tailscaleAddresses();
      const hubSockets = (listeners || []).filter((l) => l.port === hubPort);
      const exposed = hubSockets.some((l) => openToNetwork(l.host, ts));
      const others = (listeners || []).filter((l) => l.port !== hubPort && openToNetwork(l.host, ts) && /^(node|python|ruby|php|java|deno|bun)/i.test(l.command));
      console.log([
        `listening on     ${listeners === null ? 'could not check (lsof did not run)' : hubSockets.length ? [...new Set(hubSockets.map((l) => `${l.host}:${l.port}`))].join(', ') : '(nothing)'}  (kitt.json: ${plan.mode}${plan.expires ? ` until ${plan.expires}` : ''})${exposed ? '  → OPEN TO THE LOCAL NETWORK; close: bash scripts/uat-lan.sh off' : ''}`,
        `other servers    ${listeners === null ? 'could not check (lsof did not run)' : others.length ? [...new Set(others.map((l) => `${l.command} ${l.host}:${l.port}`))].join(', ') + ' open to the network' : 'none open to the network'}`,
        `macOS firewall   ${firewall}${firewall === 'off' ? '  → System Settings › Network › Firewall: turn it on' : ''}`,
      ].join('\n'));
      console.log([`hub process      ${healthz}`,`launchd agent    ${la ? 'installed' : 'NOT installed → sh ~/dev/kitt/scripts/install.sh'}`, `tunnel agent     ${ng ? 'installed' : 'NOT installed (ngrok) — prefer Tailscale; see docs/APPLE_APPS_PLAN.md §5'}`, `public_base_url  ${app.config.server?.public_base_url || '(unset)'}`, `power            ${batt}`, `sleep (AC/batt)  ${acSleep ?? '?'} / ${battSleep ?? '?'} min  ${acSleep && Number(acSleep) > 0 ? '→ run: sudo pmset -c sleep 0 displaysleep 15' : ''}`, `7-day coverage   ${cov.uptime_pct}% of expected heartbeats (${cov.heartbeats}/${cov.expected}), on AC ${cov.on_ac_pct ?? '?'}%`, `tokens           full=${app.secrets.KITT_TOKEN ? 'set' : 'MISSING'} app=${app.secrets.KITT_APP_TOKEN ? 'set' : 'MISSING (kitt token new app)'} feed=${app.secrets.KITT_FEED_TOKEN ? 'set' : 'MISSING'}`].join('\n'));
      break;
    }
    case 'setup': {
      const h = await app.health();
      const s = app.secrets; const have = (k) => (s[k] ? 'set' : 'MISSING');
      console.log(`config dir   ${app.paths.configDir}\ndata dir     ${app.paths.dataDir}\nenv file     ${app.paths.envFile} (${fs.existsSync(app.paths.envFile) ? 'exists' : 'missing'})\nKITT_TOKEN   ${have('KITT_TOKEN')}\nKITT_FEED_TOKEN ${have('KITT_FEED_TOKEN')}\nResend       ${h.notifier.email ? 'configured' : 'MISSING (RESEND_API_KEY/RESEND_FROM)'}\nntfy push    ${h.notifier.push ? 'configured' : 'MISSING (NTFY_TOPIC)'}\nbrain        ${h.brain.provider} → ${h.brain.ok ? 'OK' : 'FAIL'} ${h.brain.detail || ''}\ncomposio     ${h.composio ? 'present' : 'MISSING'}`);
      for (const [id, v] of Object.entries(h.skills)) console.log(`skill ${id.padEnd(14)} ${v.ok ? 'OK' : 'ATTENTION'}  ${v.detail || ''}`);
      break;
    }
    case 'whatsapp': { const s = app.skills.whatsapp; if (!s) throw new Error('whatsapp skill unavailable'); if (rest[0] === 'status') console.log(JSON.stringify(await s.health(), null, 2)); else throw new Error('usage: kitt whatsapp link|status'); break; }
    default: process.stdout.write(USAGE); process.exitCode = 1;
  }
  app.scheduler.stop();
}

main().catch((e) => { console.error(`kitt: ${e.message}`); process.exit(1); });
